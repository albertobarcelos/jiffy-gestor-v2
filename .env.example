# =====================================================
# Jiffy Gestor — variáveis relevantes ao Cardápio
# =====================================================
# (copie as que precisar para .env.local)

# Host do apps/jiffy-cardapio. Quando preenchido:
# - /delivery/* e /cardapio/* no Gestor redirecionam (308) para esse host
# - o hub copia o link canônico {host}/{slug}
# Preferir NEXT_PUBLIC_ (visível no browser do hub). CARDAPIO_PUBLIC_URL = alias server.
# Dev: http://localhost:5001
# Prod: https://cardapio.jiffy.run
# NEXT_PUBLIC_CARDAPIO_PUBLIC_URL=
# CARDAPIO_PUBLIC_URL=

# Google Maps — cliente (mapa da empresa / cobertura no Gestor)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps — servidor (BFF: geocode, Places autocomplete/details)
# Places API (New) precisa estar habilitada. Restrição só de HTTP referrer
# bloqueia o BFF. Em local, inclua http://localhost:5000/*
# GOOGLE_MAPS_API_KEY=
