{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fredy",
  "mainBinaryName": "Fredy",
  "version": "0.1.1",
  "identifier": "br.com.nexsyn.jiffy-flow",
  "build": {
    "frontendDist": "http://127.0.0.1:5000/pedidos/empresas?gestor",
    "devUrl": "http://127.0.0.1:5000/pedidos/empresas?gestor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Fredy",
        "width": 1280,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      },
      {
        "label": "bolha",
        "create": false,
        "title": "Fredy",
        "width": 56,
        "height": 56,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NexSyn",
    "copyright": "NexSyn",
    "shortDescription": "Gestor de pedidos. Por Jiffy.",
    "longDescription": "Fredy recebe, organiza e acompanha os pedidos da loja no Windows. Não imprime. O Jiffy Print instala-se à parte.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"],
        "startMenuFolder": "Fredy",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gestor-pedidos"]
      }
    }
  }
}
