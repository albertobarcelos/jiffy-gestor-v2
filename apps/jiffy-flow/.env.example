# Origem do Gestor (Next). O casco abre /pedidos/empresas?gestor se faltar o path.
# Copie este arquivo para .env (gitignored) e aponte para a porta do Gestor.
GESTOR_PEDIDOS_URL=http://127.0.0.1:5000

# Se o Gestor local usar outra porta (.env.local PORT=...), ajuste aqui. Ex.: 5550.
# GESTOR_PEDIDOS_URL=http://127.0.0.1:5550

# Homolog (dev e piloto). No tauri:dev precisa da flag, senão volta para localhost:
# GESTOR_PEDIDOS_URL=https://gestor.homolog.jiffy.run
# JIFFY_FLOW_USE_CLOUD_GESTOR=1

# Produção (Setup da loja — passar em package-flow.ps1 -GestorUrl):
# GESTOR_PEDIDOS_URL=https://app.jiffy.run

# Host publico do bucket R2 `jiffy-flow`.
# JIFFY_FLOW_R2_PUBLIC_BASE=https://pub-143026e1401641a5ad59a389410eed2a.r2.dev
