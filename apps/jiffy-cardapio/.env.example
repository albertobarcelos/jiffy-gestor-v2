# =====================================================
# jiffy-cardapio — Variáveis de Ambiente (Exemplo)
# =====================================================
# Copie este arquivo para .env.local e preencha os valores

# URL do backend principal (Node.js Orchestrator ou API interna)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL base da API externa (usada pelo BFF proxy)
NEXT_PUBLIC_EXTERNAL_API_BASE_URL=http://localhost:3000

# Porta do servidor de desenvolvimento do cardápio público
CARDAPIO_PORT=5001

# Google Maps API Key (para geolocalização de endereço de entrega)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Ignorar verificação TLS (apenas desenvolvimento com certs auto-assinados)
# API_TLS_SKIP_VERIFY=true
